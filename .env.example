# ================= 上海停车情报站 · 自部署环境变量 =================
# 复制为 .env 后按需修改：cp .env.example .env

# 必填：PostgreSQL 连接串
# 注意：应用（@lark-apaas/fullstack-nestjs-core）读取的是 SUDA_DATABASE_URL，
#       不是 DATABASE_URL。变量名写错会连不上库。
SUDA_DATABASE_URL=postgresql://parking:parking_pass@127.0.0.1:5432/parking

# 运行环境
NODE_ENV=production

# 监听地址：容器内必须 0.0.0.0，否则容器外访问不到
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# 日志
LOG_DIR=./logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# 请求体大小上限（默认 1mb）
# BODY_SIZE_LIMIT=10mb
