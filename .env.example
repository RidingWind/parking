# ================= 上海停车情报站 · 自部署环境变量 =================
# 复制为 .env 后按需修改：cp .env.example .env

# 必填：平台基础域名。
# 平台核心模块在“平台模式”下强制要求该变量，缺失会启动报错：
#   Error: 平台模式需要基础域名，请设置环境变量 FORCE_AUTHN_INNERAPI_DOMAIN
# 自部署可填自己的访问地址，例如 http://<ECS公网IP> 或 https://parking.example.com
FORCE_AUTHN_INNERAPI_DOMAIN=http://127.0.0.1:3000

# CSRF：平台 CSRF 依赖平台 cookie，脱离平台后会导致 /api/* 返回 403，
# 自部署默认关闭（本文件不写即关闭）；如需开启设为 true
# ENABLE_CSRF=true

# 必填：PostgreSQL 连接串
# 注意：应用（@lark-apaas/fullstack-nestjs-core）读取的是 SUDA_DATABASE_URL，
#       不是 DATABASE_URL。变量名写错会连不上库。
SUDA_DATABASE_URL=postgresql://parking:parking_pass@127.0.0.1:5432/parking

# 运行环境
NODE_ENV=production

# 监听地址：容器内必须 0.0.0.0，否则容器外访问不到
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# 日志
LOG_DIR=./logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# 请求体大小上限（默认 1mb）
# BODY_SIZE_LIMIT=10mb
